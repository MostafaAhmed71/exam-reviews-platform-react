# PHP Configuration for Large File Uploads
# This file ensures PHP settings allow uploading large video files (up to 500MB)

# Increase upload and post max size
php_value upload_max_filesize 500M
php_value post_max_size 500M

# Increase execution time for large uploads (unlimited for upload.php)
php_value max_execution_time 0
php_value max_input_time 0

# Increase memory limit
php_value memory_limit 512M

# Disable output buffering for better upload handling
php_value output_buffering Off

# Enable file uploads
php_flag file_uploads On

# Security Headers
<IfModule mod_headers.c>
    # Content Security Policy - unsafe-inline removed from script-src (moved MathJax config to external file)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https: blob:; media-src 'self' https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://northelite0.com; frame-src 'self' https://www.youtube.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
    
    # X-Frame-Options - Protect against Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # X-Content-Type-Options - Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # X-XSS-Protection - Enable XSS filter
    Header set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy (formerly Feature Policy)
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # CORS Headers - Restricted to specific domains for security
    # MUST be set BEFORE any redirects
    # CRITICAL: These headers are set at Apache level to ensure they're sent even if PHP times out
    # IMPORTANT: "always" directive ensures headers are sent even for error responses (404, 500, 504, etc.)
    # SECURITY: Only allow specific domains instead of "*" to prevent unauthorized access
    
    # Define allowed origins (whitelist)
    SetEnvIf Origin "^https?://(www\.)?(mufid\.northelite0\.com|northelite0\.com|review\.northelite0\.com|momo01\.netlify\.app|.*\.netlify\.app)$" CORS_ORIGIN=$0
    SetEnvIf Origin "^https?://localhost(:[0-9]+)?$" CORS_ORIGIN=$0
    SetEnvIf Origin "^https?://127\.0\.0\.1(:[0-9]+)?$" CORS_ORIGIN=$0
    
    # Set CORS headers only for allowed origins
    Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
    Header always set Access-Control-Allow-Methods "POST, OPTIONS, GET, PUT, DELETE" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Headers "Content-Type, Content-Length, X-Requested-With, Accept, Origin" env=CORS_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    Header always set Access-Control-Max-Age "86400" env=CORS_ORIGIN
    
    # Specifically for upload.php - ensure CORS headers are ALWAYS sent for allowed origins
    # This is critical for large file uploads that may timeout
    <FilesMatch "upload\.php$">
        Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
        Header always set Access-Control-Allow-Methods "POST, OPTIONS, GET" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Headers "Content-Type, Content-Length, X-Requested-With, Accept, Origin" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
        Header always set Access-Control-Max-Age "86400" env=CORS_ORIGIN
        Header always set Access-Control-Expose-Headers "Content-Length" env=CORS_ORIGIN
    </FilesMatch>
    
    # Set CORS headers for error responses (404, 500, 504, etc.) - only for allowed origins
    # This ensures CORS headers are sent even when Gateway timeout occurs
    <If "%{REQUEST_URI} =~ m#(upload|delete|test_cors)\.php#">
        Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
        Header always set Access-Control-Allow-Methods "POST, OPTIONS, GET, DELETE" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Headers "Content-Type, Content-Length, X-Requested-With, Accept, Origin" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    </If>
    
    # CORS headers for video and media files (mp4, avi, mov, etc.)
    # This allows videos to be loaded from allowed origins
    <FilesMatch "\.(mp4|avi|mov|wmv|flv|webm|mkv|m4v|3gp|mp3|wav|ogg)$">
        Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
        Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Headers "Range, Content-Type, Accept, Origin" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
        Header always set Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" env=CORS_ORIGIN
    </FilesMatch>
    
    # CORS headers for images (jpg, png, gif, webp, etc.)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|bmp|ico)$">
        Header always set Access-Control-Allow-Origin %{CORS_ORIGIN}e env=CORS_ORIGIN
        Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Headers "Content-Type, Accept, Origin" env=CORS_ORIGIN
        Header always set Access-Control-Allow-Credentials "true" env=CORS_ORIGIN
    </FilesMatch>
</IfModule>

# Increase timeout for upload.php specifically
<IfModule mod_reqtimeout.c>
    RequestReadTimeout body=0
    RequestReadTimeout header=0
</IfModule>

# Increase Apache timeout for large uploads (1 hour = 3600 seconds)
<IfModule mod_timeout.c>
    Timeout 3600
</IfModule>

# Increase FastCGI timeout (if using PHP-FPM)
<IfModule mod_fastcgi.c>
    FastCgiConfig -idle-timeout 3600
    FastCgiConfig -connect-timeout 3600
</IfModule>

# Increase Proxy timeout (if behind reverse proxy/load balancer)
<IfModule mod_proxy.c>
    ProxyTimeout 3600
    ProxyConnectTimeout 3600
</IfModule>

# Prevent redirects for upload.php (if using mod_rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Don't redirect upload.php - this is critical!
    RewriteCond %{REQUEST_URI} ^/upload\.php$ [NC]
    RewriteRule ^ - [L]
    
    # Add your other rewrite rules here if needed
    # (but upload.php will not be affected)
</IfModule>

# Note: If these directives don't work, your hosting provider may have disabled
# php_value in .htaccess. In that case, you'll need to:
# 1. Contact your hosting provider to increase these limits
# 2. Or create/update php.ini file with these values
# 3. Or use ini_set() in upload.php (which may have limited effect)
